#:kivy 2.0

#:import math math

<MoonCanvas>:
    canvas:
        Color:
            rgba: 0.05, 0.05, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size
        
        # Draw stars
        Color:
            rgba: 1, 1, 1, 0.8
        Line:
            points: self.get_stars_points()
            width: 1
        
        # Moon
        Color:
            rgba: 0.9, 0.9, 0.95, 1
        Ellipse:
            pos: self.center_x - 100, self.center_y - 100
            size: 200, 200
        
        # Glow
        Color:
            rgba: 0.8, 0.8, 1.0, self.glow_intensity * 0.3
        Ellipse:
            pos: self.center_x - 130, self.center_y - 130
            size: 260, 260

BoxLayout:
    orientation: 'vertical'
    
    MoonCanvas:
        size_hint_y: 0.8
    
    GridLayout:
        cols: 2
        size_hint_y: 0.2
        padding: 10
        spacing: 10
        
        Button:
            text: 'Set as Wallpaper'
            on_press: app.set_as_wallpaper(self)
        
        Button:
            text: 'Settings'
            on_press: app.show_settings(self)
